{
  "name": "flores-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node scripts/prepare-static.mjs && next dev",
    "build": "node scripts/prepare-static.mjs && next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "supabase": "supabase",
    "db:types:local": "node scripts/generate-database-types.mjs",
    "backend:env": "node scripts/init-backend-env.mjs",
    "backend:check": "node scripts/check-backend-config.mjs",
    "backend:admin": "node scripts/provision-admin.mjs",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.edge.json --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.31.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
